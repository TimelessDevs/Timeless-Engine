package psychlua;

#if (!flash && sys)
import flixel.FlxSprite;
import flixel.FlxCamera;
import flixel.addons.display.FlxRuntimeShader;
import openfl.filters.ShaderFilter;
import openfl.filters.BitmapFilter;
import states.PlayState;

class ShItem
{
	public var key:String;
	public var path:String;
	public var kind:String;
	public var side:Int;
	public var lane:Int;
	public var dyn:Bool = false;
	public var spr:FlxSprite = null;
	public var shader:FlxRuntimeShader = null;
	public var pooled:Bool = false;
	public var active:Bool = true;
	public var cam:FlxCamera = null;
	public var filter:ShaderFilter = null;

	public function new(key:String, path:String, kind:String, side:Int, lane:Int)
	{
		this.key = key;
		this.path = path;
		this.kind = kind;
		this.side = side;
		this.lane = lane;
	}
}

/**
 * Runtime used by the scripts generated by the Shader Editor.
 * - keeps references to the sprites (never indexes), so notes that are removed can not crash the game
 * - re-applies the shader every frame (StrumNote.playAnim resets sprite.shader to the RGB palette shader)
 * - keeps u_frame in sync AFTER the animation advanced (no blinking characters)
 * - notes share pooled shader instances (one compiled program per lane / frame, not one per note)
 * - re-resolves characters every frame (Change Character)
 */
class ShaderBinder
{
	static var all:Map<String, ShaderBinder> = new Map();

	public static function get(ns:String):ShaderBinder
	{
		var b = all.get(ns);
		if (b == null)
		{
			b = new ShaderBinder();
			all.set(ns, b);
		}
		return b;
	}

	public var items:Array<ShItem> = [];
	public var on:Bool = true;
	public var frag:String = null;
	public var vert:String = null;

	var byKey:Map<String, ShItem> = new Map();
	var pool:Map<String, FlxRuntimeShader> = new Map();
	var defF:Map<String, Float> = new Map();
	var defV:Map<String, Array<Float>> = new Map();
	var defS:Map<String, String> = new Map();
	var palette:Array<String> = [];
	var useTime:Bool = false;
	var useBeat:Bool = false;
	var useFrame:Bool = false;
	var animNotes:Bool = false;
	var lastTime:Float = 0;
	var lastBeat:Float = 0;
	var counter:Int = 0;

	public function new() {}

	public function reset()
	{
		for (it in items)
			release(it);
		items = [];
		byKey = new Map();
		pool = new Map();
		defF = new Map();
		defV = new Map();
		defS = new Map();
		palette = [];
		on = true;
	}

	public function config(t:Bool, b:Bool, f:Bool, an:Bool)
	{
		useTime = t;
		useBeat = b;
		useFrame = f;
		animNotes = an;
	}

	public function setPalette(names:Array<String>)
		palette = names;

	public function defFloat(n:String, v:Float)
		defF.set(n, v);

	public function defVec3(n:String, a:Float, b:Float, c:Float)
		defV.set(n, [a, b, c]);

	public function defTex(n:String, path:String)
		defS.set(n, path);

	// ------------------------------------------------------------------ helpers
	function makeShader():FlxRuntimeShader
	{
		if (frag == null && vert == null)
			return null;
		try
		{
			return new FlxRuntimeShader(frag, vert);
		}
		catch (e:Dynamic)
		{
			trace('[ShaderBinder] shader error: ' + e);
			return null;
		}
	}

	function applyDefaults(sh:FlxRuntimeShader)
	{
		if (sh == null)
			return;
		for (k => v in defF)
			try
				sh.setFloat(k, v)
			catch (e:Dynamic) {}
		for (k => v in defV)
			try
				sh.setFloatArray(k, v)
			catch (e:Dynamic) {}
		for (k => v in defS)
			try
			{
				var g = Paths.image(v);
				if (g != null && g.bitmap != null)
					sh.setSampler2D(k, g.bitmap);
			}
			catch (e:Dynamic) {}
	}

	function applyPalette(sh:FlxRuntimeShader, spr:FlxSprite)
	{
		if (palette.length != 3 || sh == null || spr == null)
			return;
		try
		{
			var rs:Dynamic = Reflect.getProperty(spr, 'rgbShader');
			if (rs == null)
				return;
			var ch = ['r', 'g', 'b'];
			for (i in 0...3)
			{
				var c:Int = Reflect.getProperty(rs, ch[i]);
				sh.setFloatArray(palette[i], [((c >> 16) & 0xFF) / 255, ((c >> 8) & 0xFF) / 255, (c & 0xFF) / 255]);
			}
		}
		catch (e:Dynamic) {}
	}

	function setFrame(sh:FlxRuntimeShader, spr:FlxSprite)
	{
		if (!useFrame || sh == null || spr == null || spr.frame == null)
			return;
		try
		{
			var fr = spr.frame.frame;
			sh.setFloatArray('u_frame', [fr.x, fr.y, fr.width, fr.height]);
		}
		catch (e:Dynamic) {}
	}

	function setDyn(sh:FlxRuntimeShader, t:Float, b:Float)
	{
		if (sh == null)
			return;
		try
		{
			if (useTime)
				sh.setFloat('u_time', t);
			if (useBeat)
				sh.setFloat('u_beat', b);
		}
		catch (e:Dynamic) {}
	}

	static function origShader(spr:FlxSprite):Dynamic
	{
		try
		{
			var rs:Dynamic = Reflect.getProperty(spr, 'rgbShader');
			if (rs != null)
			{
				var en:Dynamic = Reflect.getProperty(rs, 'enabled');
				var sh:Dynamic = Reflect.getProperty(rs, 'shader');
				if (en != false && sh != null)
					return sh;
			}
		}
		catch (e:Dynamic) {}
		return null;
	}

	static function restoreSprite(spr:FlxSprite, ours:Dynamic)
	{
		if (spr == null)
			return;
		var cur:Dynamic = spr.shader;
		if (ours != null && cur != ours)
			return;
		var o:Dynamic = origShader(spr);
		spr.shader = o;
	}

	static function resolve(path:String):FlxSprite
	{
		if (path == null || path == '' || PlayState.instance == null)
			return null;
		try
		{
			var split = path.split('.');
			var o:Dynamic = LuaUtils.getObjectDirectly(split[0]);
			for (i in 1...split.length)
			{
				if (o == null)
					return null;
				o = LuaUtils.getVarInArray(o, split[i]);
			}
			return Std.isOfType(o, FlxSprite) ? cast o : null;
		}
		catch (e:Dynamic)
		{
			return null;
		}
	}

	function attach(it:ShItem, spr:FlxSprite)
	{
		it.spr = spr;
		if (!it.pooled)
			it.shader = makeShader();
		if (it.shader == null)
			return;
		if (!it.pooled)
		{
			applyDefaults(it.shader);
			if (it.kind == 'strum')
				applyPalette(it.shader, spr);
			setFrame(it.shader, spr);
			setDyn(it.shader, lastTime, lastBeat);
		}
		if (it.active)
			spr.shader = it.shader;
	}

	function release(it:ShItem)
	{
		try
		{
			if (it.cam != null)
			{
				setCam(it, false);
				return;
			}
			if (it.spr != null)
				restoreSprite(it.spr, it.shader);
		}
		catch (e:Dynamic) {}
	}

	function setCam(it:ShItem, enable:Bool)
	{
		if (it.cam == null || it.filter == null)
			return;
		var arr:Array<BitmapFilter> = (it.cam.filters == null) ? [] : it.cam.filters.copy();
		arr.remove(it.filter);
		if (enable)
			arr.push(it.filter);
		it.cam.filters = arr;
	}

	function matches(it:ShItem, lane:Int, side:Int):Bool
	{
		if (lane < 0 && side < 0)
			return true;
		if (it.kind == 'note' || it.kind == 'cam')
			return false;
		if (it.kind == 'strum')
			return (lane < 0 || it.lane == lane) && (side < 0 || it.side == side);
		return true;
	}

	// ------------------------------------------------------------------ binding
	public function bind(key:String, path:String, kind:String, side:Int, lane:Int):Bool
	{
		var old = byKey.get(key);
		if (old != null)
		{
			release(old);
			items.remove(old);
		}
		var it = new ShItem(key, path, kind, side, lane);
		it.dyn = (kind == 'char' || kind == 'obj');
		it.active = on;
		items.push(it);
		byKey.set(key, it);
		var s = resolve(path);
		if (s != null)
			attach(it, s);
		return true;
	}

	public function bindNote(id:Int, lane:Int, want:Int):Bool
	{
		var ps = PlayState.instance;
		if (ps == null || ps.notes == null || id < 0 || id >= ps.notes.members.length)
			return false;
		var n:FlxSprite = ps.notes.members[id];
		if (n == null || n.frame == null)
			return false;
		var must:Bool = Reflect.getProperty(n, 'mustPress') == true;
		if ((want == 1 && !must) || (want == 2 && must))
			return false;
		var fr = n.frame.frame;
		var pk = lane + '|' + Std.int(fr.x) + ',' + Std.int(fr.y) + ',' + Std.int(fr.width) + ',' + Std.int(fr.height);
		try
		{
			var rs:Dynamic = Reflect.getProperty(n, 'rgbShader');
			if (rs != null && palette.length == 3)
				for (c in ['r', 'g', 'b'])
					pk += '|' + Reflect.getProperty(rs, c);
		}
		catch (e:Dynamic) {}
		var sh = pool.get(pk);
		if (sh == null)
		{
			sh = makeShader();
			if (sh == null)
				return false;
			applyDefaults(sh);
			applyPalette(sh, n);
			setFrame(sh, n);
			setDyn(sh, lastTime, lastBeat);
			pool.set(pk, sh);
		}
		var it = new ShItem('n' + (counter++), '', 'note', must ? 1 : 2, lane);
		it.pooled = true;
		it.shader = sh;
		it.active = on;
		items.push(it);
		attach(it, n);
		return true;
	}

	public function bindCamera(key:String, camName:String):Bool
	{
		var ps = PlayState.instance;
		if (ps == null)
			return false;
		var cam:FlxCamera = cast Reflect.getProperty(ps, camName);
		if (cam == null)
			return false;
		var sh = makeShader();
		if (sh == null)
			return false;
		applyDefaults(sh);
		var it = new ShItem(key, '', 'cam', 0, -1);
		it.cam = cam;
		it.shader = sh;
		it.filter = new ShaderFilter(sh);
		it.active = on;
		items.push(it);
		byKey.set(key, it);
		if (on)
			setCam(it, true);
		return true;
	}

	// ------------------------------------------------------------------ runtime
	public function setFloatAll(name:String, v:Float, lane:Int, side:Int)
	{
		if (lane < 0 && side < 0)
		{
			defF.set(name, v);
			for (sh in pool)
				try
					sh.setFloat(name, v)
				catch (e:Dynamic) {}
		}
		for (it in items)
			if (!it.pooled && it.shader != null && matches(it, lane, side))
				try
					it.shader.setFloat(name, v)
				catch (e:Dynamic) {}
	}

	public function setActive(enable:Bool, lane:Int, side:Int)
	{
		if (lane < 0 && side < 0)
			on = enable;
		for (it in items)
		{
			if (!matches(it, lane, side))
				continue;
			it.active = enable;
			if (it.cam != null)
				setCam(it, enable);
			else if (it.spr != null && it.shader != null)
			{
				if (enable)
					it.spr.shader = it.shader;
				else
					restoreSprite(it.spr, it.shader);
			}
		}
	}

	public function tick(time:Float, beat:Float)
	{
		lastTime = time;
		lastBeat = beat;
		var i = items.length;
		while (--i >= 0)
		{
			var it = items[i];
			if (it.cam != null)
			{
				setDyn(it.shader, time, beat);
				continue;
			}
			if (it.dyn || it.spr == null)
			{
				var s = resolve(it.path);
				if (s != null && s != it.spr)
				{
					if (it.spr != null)
						restoreSprite(it.spr, it.shader);
					attach(it, s);
				}
			}
			var spr = it.spr;
			if (spr == null)
				continue;
			if (it.kind == 'note' && (!spr.exists || !spr.alive))
			{
				items.remove(it);
				continue;
			}
			if (it.shader == null)
				continue;
			if (it.active)
			{
				var cur:Dynamic = spr.shader;
				var mine:Dynamic = it.shader;
				if (cur != mine)
					spr.shader = mine;
			}
			if (!it.pooled)
			{
				setDyn(it.shader, time, beat);
				setFrame(it.shader, spr);
			}
		}
		if (animNotes)
			for (sh in pool)
				setDyn(sh, time, beat);
	}

	public static function animInfo(who:String):String
	{
		var ps = PlayState.instance;
		if (ps == null)
			return '';
		var ch:Dynamic = (who == 'dad') ? ps.dad : ((who == 'gf') ? ps.gf : ps.boyfriend);
		if (ch == null)
			return '';
		try
		{
			var a:Dynamic = ch.animation;
			if (a == null || a.curAnim == null)
				return '';
			return Std.string(a.curAnim.name) + '|' + Std.string(a.curAnim.curFrame);
		}
		catch (e:Dynamic) {}
		return '';
	}

	public static function noteMine(id:Int):Bool
	{
		var ps = PlayState.instance;
		if (ps == null || ps.notes == null || id < 0 || id >= ps.notes.members.length || ps.notes.members[id] == null)
			return false;
		return ps.notes.members[id].mustPress;
	}
}
#end
